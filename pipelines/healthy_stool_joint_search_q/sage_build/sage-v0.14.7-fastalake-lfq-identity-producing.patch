+#[cfg(test)]
+mod mm_lfq_identity_regression {
+    use super::*;
+    use crate::database::PeptideIx;
+    use crate::lfq::{Peak, PrecursorId};
+    #[test]
+    fn target_and_decoy_keep_separate_qvalues_and_unchanged_measurements() {
+        let mut peaks = FnvHashMap::default();
+        for i in 0..100 {
+            peaks.insert((PrecursorId::Combined(PeptideIx(i)), false),
+                (Peak { score: 1.0 - f64::from(i)*0.001, ..Peak::default() }, vec![1.0,2.0]));
+        }
+        for i in 0..10 {
+            peaks.insert((PrecursorId::Combined(PeptideIx(i)), true),
+                (Peak { score: 0.1 - f64::from(i)*0.001, ..Peak::default() }, vec![3.0,4.0]));
+        }
+        let passing = picked_precursor(&mut peaks);
+        assert_eq!(passing,100);
+        for i in 0..100 {
+            let (p,v) = &peaks[&(PrecursorId::Combined(PeptideIx(i)),false)];
+            assert!((p.q_value-0.01).abs()<1e-6);
+            assert_eq!(p.score,1.0-f64::from(i)*0.001);
+            assert_eq!(*v,vec![1.0,2.0]);
+        }
+        for i in 0..10 {
+            let (p,v) = &peaks[&(PrecursorId::Combined(PeptideIx(i)),true)];
+            assert!((p.q_value-(i+2) as f32/100.0).abs()<1e-6);
+            assert_eq!(p.score,0.1-f64::from(i)*0.001);
+            assert_eq!(*v,vec![3.0,4.0]);
+        }
+    }
