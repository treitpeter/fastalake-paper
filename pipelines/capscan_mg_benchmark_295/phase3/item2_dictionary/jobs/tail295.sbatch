#!/bin/bash
# Runs after the 282-control exports finish: sizes the 295 export --mem from their measured MaxRSS x1.05 x(295/282), rounded up to whole GB (+1),
# then submits the 295 exports, H09, the negative control. Records IDs in JOBS.txt.
set -euo pipefail
CTL_FL=$1; CTL_MG=$2; R295_COLLECT=$3
mem_for() { sacct -j "$1" --format=MaxRSS -n -P | awk 'NF{v=$1;u=substr(v,length(v));n=v+0;if(u=="K")n/=1048576;else if(u=="M")n/=1024;else if(u=="G")n=n;else n/=1073741824;if(n>m)m=n}END{x=m*1.05*295/282;printf "%d", (x==int(x)?x:int(x)+1)}'; }
MF=$(mem_for $CTL_FL); MM=$(mem_for $CTL_MG)
echo "ctl export MaxRSS-based mem: FL ${MF}G metaG ${MM}G" | tee -a LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/JOBS.txt
S="sbatch --parsable --partition=p.hpcl92 --nice=10000 --cpus-per-task=1"
R=LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/runs/r295
EF=$($S --mem=${MF}G --time=03:00:00 --job-name=p3i2_exp295_FL --dependency=afterok:$R295_COLLECT --output=LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/logs/exp295_FL_%j.out LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/jobs/export.sbatch $R 295 FL)
EM=$($S --mem=${MM}G --time=04:00:00 --job-name=p3i2_exp295_MG --dependency=afterok:$R295_COLLECT --output=LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/logs/exp295_MG_%j.out LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/jobs/export.sbatch $R 295 metaG)
H=$($S --mem=4G --time=01:00:00 --job-name=p3i2_h09_295 --dependency=afterok:$EF:$EM --output=LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/logs/h09_295_%j.out LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/jobs/h09.sbatch $R 295)
N=$($S --mem=2G --time=00:20:00 --job-name=p3i2_neg --dependency=afterok:$H --output=LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/logs/neg_%j.out LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/jobs/negative.sbatch)
printf "r295 export FL %s (mem %sG)\nr295 export metaG %s (mem %sG)\nr295 h09 %s\nnegative control %s\n" $EF $MF $EM $MM $H $N | tee -a LAB_ROOT/review/v15_integration/jess_integration_2026-09-29/analysis_followup/manuscript_completion_2026-10-01/biology_refit/claude_review_2026-10-03/final/mg295/phase3/item2_dictionary/JOBS.txt
